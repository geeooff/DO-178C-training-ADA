--  ---------------------------------------------------------------------------
--  Le MÊME code source, compilé sous un profil sans exceptions.
--
--  Ce projet ne duplique rien : il pointe sur ../src. Sa seule raison d'être
--  est de démontrer, par la construction, que Mod06.Sensor_Io ne dépend
--  d'aucune exception — ce qu'aucune relecture ne peut garantir.
--
--  -gnatp est indispensable ici, et c'est tout l'intérêt de la
--  démonstration. Sans lui, GNAT signale par -gnatw.x chaque endroit où une
--  vérification pourrait lever une exception qui ne peut pas se propager ;
--  avec -gnatwe, ces avertissements sont des erreurs. Autrement dit :
--  interdire les exceptions OBLIGE à supprimer les vérifications, ce qui
--  OBLIGE à les avoir prouvées (modules 02 et 05). Les trois modules se
--  referment ici.
--  ---------------------------------------------------------------------------
with "../../../shared.gpr";

project Restreint is

   for Source_Dirs use ("../src", "src");
   for Excluded_Source_Files use ("main.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("restricted_demo.adb");

   package Builder is
      for Global_Configuration_Pragmas use "restrictions.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        Shared.Compiler'Default_Switches ("Ada") & ("-gnatp");
   end Compiler;

   package Prove renames Shared.Prove;

end Restreint;
