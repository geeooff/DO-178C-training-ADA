--  ---------------------------------------------------------------------------
--  Démonstration du profil Ravenscar — module 07.
--
--  Sous-projet séparé pour une raison simple : les restrictions Ravenscar
--  sont vérifiées sur toute la partition, et le harnais de test de common/
--  ne les respecte pas. Les isoler ici permet de les appliquer POUR DE VRAI
--  plutôt que de les décrire.
--
--  -fstack-usage demande au compilateur d'écrire la taille de trame de
--  chaque sous-programme dans un fichier .su. C'est la matière première de
--  l'analyse de pile, que scripts/stack-usage.sh agrège.
--  ---------------------------------------------------------------------------
with "../../../shared.gpr";

project Ravenscar is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("ravenscar_demo.adb");

   package Builder is
      for Global_Configuration_Pragmas use "profile.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        Shared.Compiler'Default_Switches ("Ada") & ("-fstack-usage");
   end Compiler;

   package Prove renames Shared.Prove;

end Ravenscar;
